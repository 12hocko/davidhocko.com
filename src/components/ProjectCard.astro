---
import Img from './Img.astro';

interface Props {
  href: string;
  title: string;
  line: string;
  meta: string;
  image: string;
  alt: string;
  vt: string;
  ratio?: string;
  sizes?: string;
  big?: boolean;
  eager?: boolean;
}
const { href, title, line, meta, image, alt, vt, ratio, sizes = '(max-width: 768px) 100vw, 640px', big = false, eager = false } = Astro.props;
---
<a href={href} class="zoom group block">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 pb-6 md:pb-7">
    <div class="max-w-[780px]">
      <h3 class="m-0 t-card">{title}</h3>
      <p class="m-0 mt-2 t-body text-body" set:html={line} />
    </div>
    <p class="m-0 t-meta md:text-right" set:html={meta} />
  </div>
  <Img id={image} alt={alt} ratio={ratio} sizes={sizes} vt={vt} eager={eager} />
</a>
